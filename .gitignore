# Large genomic data (should never be inside the repository)
*.bam
*.bai
*.pbi
*.pod5
*.fast5
*.fastq
*.fq
*.fasta
*.fa
*.fna
*.gfa
*.fastq.gz
*.fq.gz
*.fasta.gz
*.fa.gz
*.bin
*.sif
*.meryl/
*.sam
*.cram
*.crai
*.blow5
*.slow5
*.h5
*.paf
*.tar
*.tar.gz
*.tgz

# Local inputs and outputs (live outside pipeline/ by convention)
data/
results/
logs/
scratch/
tmp/
busco_downloads/
busco_*/
nohup.out
*.stdout.log
*.stderr.log

# Machine-specific configuration
config/local/*
!config/local/README.md
!config/local/local.example.yaml

# Snakemake / Python caches
.snakemake/
__pycache__/
*.pyc

# Local agent preferences
CLAUDE.local.md
.claude/settings.local.json

# Credentials and environment files
.env
*.pem
*.key
id_rsa*
id_ed25519*
.netrc

# OS / editor files
.DS_Store
*.swp
*~

# Per-project configuration (tracked templates: *.example.yaml)
config/samples.yaml
config/external_assemblies.yaml

# Private research and operational records never belong in Git
# (keep them in ../project_records/; see AGENTS.md, Repository hygiene)
project_records/
private/
docs/private/
docs/**/*.tsv
docs/**/*.json

# Execution logs and job output (synthetic test fixtures excepted)
*.log
!tests/fixtures/*synthetic*.log
*.out
.nextflow*
slurm-*.out

# AI session data
.claude/projects/
*.jsonl
