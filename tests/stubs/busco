#!/usr/bin/env python3
"""Test stub for BUSCO: writes the short-summary JSON of a real BUSCO run
(tests/fixtures) under the requested output location."""
import json
import os
import sys

args = sys.argv[1:]
if "--version" in args:
    print("BUSCO stub")
    sys.exit(0)
out_path, name, lineage = (args[args.index(k) + 1] for k in ("--out_path", "-o", "-l"))
lin = os.path.basename(lineage.rstrip("/"))
here = os.path.dirname(os.path.abspath(__file__))
d = json.load(open(os.path.join(here, "..", "fixtures",
                                "busco_short_summary_PHBW8_l0_liliopsida_odb10.json")))
d["lineage_dataset"]["name"] = lin
os.makedirs(os.path.join(out_path, name), exist_ok=True)
json.dump(d, open(os.path.join(out_path, name, f"short_summary.specific.{lin}.{name}.json"), "w"))
