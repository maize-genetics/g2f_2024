# Genome assembly and QC workflow (HiFi, optional ultra-long ONT; hifiasm).
#
# Run from the pipeline/ directory:
#   snakemake --profile profiles/local --dry-run --printshellcmds
#   snakemake --profile profiles/local --cores 64
#   snakemake --profile profiles/local --cores 32 imported_qc   # registered previous assemblies
#   snakemake --profile profiles/local --cores 32 fingerprint   # optional genotype QC
#
# Stages: input discovery -> HiFi/ONT read preprocessing and QC -> k-mer
# screen -> hifiasm (method chosen automatically) -> GFA-to-FASTA with
# consistency checks -> assembly statistics, BUSCO, Merqury -> validated
# per-sample and project summary tables.

import os
import sys

from snakemake.utils import min_version

min_version("8.0")

PIPELINE_DIR = os.path.abspath(os.path.join(workflow.basedir, ".."))
sys.path.insert(0, os.path.join(PIPELINE_DIR, "scripts"))

from g2f.config import top_config_path  # noqa: E402

# $PIPELINE_CONFIG, else config/local/config.yaml (untracked), else config/config.yaml.
configfile: top_config_path(PIPELINE_DIR)


include: "rules/common.smk"
include: "rules/inputs.smk"
include: "rules/hifi.smk"
include: "rules/ont.smk"
include: "rules/kmer.smk"
include: "rules/prepared.smk"
include: "rules/assembly.smk"
include: "rules/imported.smk"
include: "rules/qc.smk"
include: "rules/summary.smk"
include: "rules/fingerprint.smk"


rule all:
    input:
        [validated_marker(s, METHOD[s]) for s in SAMPLES],
        PROJECT_SUMMARY if SAMPLES else [],


rule per_sample:
    """Every sample's validated assembly and QC, without the project table.
    Used by scripts/run_all_assemblies.sh, which runs one sample per process."""
    input:
        [validated_marker(s, METHOD[s]) for s in SAMPLES],


rule imported_qc:
    """QC of registered read-only historical assemblies (config/external_assemblies.yaml)."""
    input:
        imported_targets(),
        IMPORTED_SUMMARY if imported_targets() else [],


rule reads_qc:
    """Preprocess and validate reads and run the k-mer screen; no assembly."""
    input:
        [p for s in SAMPLES for p in reads_qc_targets(s)],


rule fingerprint:
    """Optional genotype fingerprinting of all read sets (QC only; no assembly)."""
    input:
        rules.fingerprint_analyze.output,


rule inventory_all:
    """Write the input inventory of every discovered sample (cheap)."""
    input:
        [inventory_path(s) for s in SAMPLES],
